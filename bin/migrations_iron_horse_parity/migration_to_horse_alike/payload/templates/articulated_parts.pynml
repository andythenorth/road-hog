// add the trailing units to articulated model_variant
switch (FEAT_ROADVEHS, SELF, ${model_variant.id}_articulated_cb_switch, extra_callback_info1) {
    <tal:trailing_units repeat="trailing_unit model_variant.units">
        ${repeat.trailing_unit.index}: return ${trailing_unit.id};
    </tal:trailing_units>
  return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
