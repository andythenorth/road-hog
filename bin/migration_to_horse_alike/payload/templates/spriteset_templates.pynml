// STANDARD GRAPHICS
// -----------------

template spriteset_template_${unit.id}(y) {
    <tal:sprite repeat="bounding_box global_constants.spritesheet_bounding_boxes">
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [${bounding_box[0]}, y, ${bounding_box[1]}, ${bounding_box[2]}, ${unit.offsets[repeat.bounding_box.index][0]}, ${unit.offsets[repeat.bounding_box.index][1]}, ANIM]
    </tal:sprite>
}

// PURCHASE MENU
// -------------

template spriteset_template_purchase_${unit.id}() {
    //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [${model_variant.buy_menu_x_loc},   10, ${model_variant.buy_menu_width}, ${global_constants.docs_sprite_height}, -${int(model_variant.buy_menu_width / 2)}, -9, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
}

