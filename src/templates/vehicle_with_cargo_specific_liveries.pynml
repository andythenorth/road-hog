<!--!
    liveries mapped to cargos, but no support here for load states, just one sprite per cargo
    e.g. tank cars with black for oil, cc for chemicals, grey for petrol etc.
-->

<tal:include metal:use-macro="load: spriteset_templates.pynml" />

<tal:cargo_variants repeat="cargo_variant_num python:range(model_variant.gestalt_graphics.num_cargo_sprite_variants)">
    spriteset(${unit.id}_ss_${cargo_variant_num}, "${global_constants.graphics_path}${model_variant.model_def.model_id}.png") {
      spriteset_template_${unit.id}(${unit.spriterow_num * 30} + ${cargo_variant_num * 30} + 10)
    }

    spritegroup ${unit.id}_sg_${cargo_variant_num} {
        loaded:  [
            ${unit.id}_ss_${cargo_variant_num},
        ];
        loading: [
            ${unit.id}_ss_${cargo_variant_num},
        ];
    }
</tal:cargo_variants>

<!--! this triggers random on a new load, which was designed for use specifically with containers where colours are randomised on load
      it's not necessary for e.g. tankers, which only have livery one option per cargo -->
<tal:cargo_random_switches repeat="mapping model_variant.gestalt_graphics.cargo_row_map.items()">
    random_switch (FEAT_ROADVEHS, SELF, ${unit.id}_switch_graphics_${mapping[0]}, bitmask(TRIGGER_VEHICLE_NEW_LOAD)) {
        <tal:random_graphics_variations repeat="spriterow_num mapping[1]">
            1: return ${unit.id}_sg_${spriterow_num};
        </tal:random_graphics_variations>
    }
</tal:cargo_random_switches>

switch (FEAT_ROADVEHS, SELF, ${unit.id}_switch_graphics, cargo_type_in_veh) {
    <tal:cargos repeat="mapping model_variant.gestalt_graphics.cargo_row_map.items()">
        <tal:exclude_default_cargo condition="mapping[0] != 'DFLT'">
            ${mapping[0]}: return ${unit.id}_switch_graphics_${mapping[0]};
        </tal:exclude_default_cargo>
    </tal:cargos>
    <tal:default_cargo repeat="mapping model_variant.gestalt_graphics.cargo_row_map.items()">
        <tal:block condition="mapping[0] == 'DFLT'">
            return ${unit.id}_switch_graphics_${mapping[0]};
        </tal:block>
    </tal:default_cargo>
}
