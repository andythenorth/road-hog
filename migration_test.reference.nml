template spriteset_template_leyburn_pax(y) {
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [60, y, 12, 29, -6, -15, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [77, y, 26, 20, -12, -11, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [107, y, 33, 16, -14, -10, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [147, y, 26, 20, -6, -11, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [180, y, 12, 29, -6, -15, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [197, y, 26, 20, -14, -10, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [227, y, 33, 16, -14, -10, ANIM]
        //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
        [267, y, 26, 20, -8, -11, ANIM]
}
// PURCHASE MENU
// -------------
template spriteset_template_purchase_leyburn_pax() {
    //[left_x,  upper_y,    width,      height,     offset_x,      offset_y]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
    [227,   10, 28, 16, -14, -9, ANIM]
    [60,    10, 1, 1, 0, 0, ANIM]
}
// DEPOT VIEW
// ----------
spriteset(leyburn_pax_ss, "generated/graphics/leyburn_pax.png") {
  spriteset_template_leyburn_pax(10 + 0)
}
spritegroup leyburn_pax_sg {
    loaded:  [
        leyburn_pax_ss,
    ];
    loading: [
        leyburn_pax_ss,
    ];
}
// always include a switch to get to spritegroups even if it does nothing - the random switches need to route to it
switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_graphics, 0) {
    0: return leyburn_pax_sg;
    return leyburn_pax_sg;
}
// buy menu graphics
spriteset(leyburn_pax_ss_purchase, "generated/graphics/leyburn_pax.png") {
  spriteset_template_purchase_leyburn_pax()
}
spritegroup leyburn_pax_sg_purchase {
    loaded:  [
        leyburn_pax_ss_purchase,
    ];
    loading: [
        leyburn_pax_ss_purchase,
    ];
}
// -- capacity determined according to specific labels that might need to be handled, and otherwise cargo class -- //
        switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_cargo_capacity_by_cargo_0, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
            bitmask(CC_MAIL): return 60;
            bitmask(CC_ARMOURED): return 60;
            return 30;
        }
        switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_cargo_capacity_by_cargo_1, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
            bitmask(CC_MAIL): return 88;
            bitmask(CC_ARMOURED): return 88;
            return 44;
        }
        switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_cargo_capacity_by_cargo_2, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
            bitmask(CC_MAIL): return 118;
            bitmask(CC_ARMOURED): return 118;
            return 59;
        }
switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_cargo_capacity, param_adjust_vehicle_capacity) {
    0: leyburn_pax_switch_cargo_capacity_by_cargo_0;
    1: leyburn_pax_switch_cargo_capacity_by_cargo_1;
    2: leyburn_pax_switch_cargo_capacity_by_cargo_2;
}
// -- loading speed also determined by capacity, which varies by cargo -- //
    switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_loading_speed_by_cargo_0, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
        bitmask(CC_MAIL): return 15;
        bitmask(CC_ARMOURED): return 15;
        return 9;
    }
    switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_loading_speed_by_cargo_1, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
        bitmask(CC_MAIL): return 24;
        bitmask(CC_ARMOURED): return 24;
        return 12;
    }
    switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_loading_speed_by_cargo_2, cargo_classes & bitmask(CC_MAIL, CC_ARMOURED)) {
        bitmask(CC_MAIL): return 30;
        bitmask(CC_ARMOURED): return 30;
        return 15;
    }
switch (FEAT_ROADVEHS, SELF, leyburn_pax_switch_loading_speed, param_adjust_vehicle_capacity) {
    0: leyburn_pax_switch_loading_speed_by_cargo_0;
    1: leyburn_pax_switch_loading_speed_by_cargo_1;
    2: leyburn_pax_switch_loading_speed_by_cargo_2;
}
// -- some switches are common to all vehicles so included with properties -- //
// -- smoke -- //
switch (FEAT_ROADVEHS, SELF, leyburn_pax_create_visual_effect, [STORE_TEMP(create_effect(EFFECT_SPRITE_DIESEL, -2, 0, 10), 0x100)]) {
    return 1;
}
// -- props -- //
item(FEAT_ROADVEHS, leyburn_pax, 20) {
    property {
        name:                           string(STR_NAME_CONSIST, string(STR_NAME_LEYBURN_PAX), string(STR_NAME_SUFFIX_BUS), string(STR_NAME_SUFFIX_DIESEL));
        cargo_capacity:                 44; // use CB to set this, avoids limited size of action 0 property
        sprite_id:                      SPRITE_ID_NEW_ROADVEH; //enable new graphics - nml constant
        road_type:ROAD;
            introduction_date:              date(1919,01,01); // consist just supplies intro year - openttd randomises intro dates a bit anyway
            power:                          100hp;
            speed:                          40mph;
            tractive_effort_coefficient:    0.7;
            cost_factor:                    32.22916666666667;
            running_cost_factor:            0; // use CB to set this, avoids limited size of action 0 property
            running_cost_base:              RUNNING_COST_ROADVEH;
            model_life:                     VEHICLE_NEVER_EXPIRES;
            vehicle_life:                   40;
            reliability_decay:              20; // default value
            retire_early:                   -10;
            sound_effect:                   SOUND_DEPARTURE_OLD_RV_1;
        refit_cost:                     0; // this needs to be 0 if we want autorefit without using cb
        refittable_cargo_classes:       bitmask();
        non_refittable_cargo_classes:   bitmask(); // don't set non-refittable classes, increases likelihood of breaking cargo support
        cargo_allow_refit:              [];
        cargo_disallow_refit:           [];
            default_cargo_type:             PASS;
        cargo_age_period:               185;
        misc_flags:                     bitmask(ROADVEH_FLAG_2CC,ROADVEH_FLAG_AUTOREFIT); // nml constants
        length:                         7;
        effect_spawn_model:             EFFECT_SPAWN_MODEL_DIESEL;
    }
    graphics {
        cargo_capacity:                 leyburn_pax_switch_cargo_capacity;
        purchase_cargo_capacity:        leyburn_pax_switch_cargo_capacity;
        loading_speed:                  leyburn_pax_switch_loading_speed;
        default:                        leyburn_pax_switch_graphics;
        purchase:                       leyburn_pax_sg_purchase;
        create_effect:                  leyburn_pax_create_visual_effect;
            running_cost_factor:            return 64;
            weight:                         return 29;
    }
}
if (param[1]==0) {
    item(FEAT_ROADVEHS, leyburn_pax, 20) {
        property {
            climates_available:             ALL_CLIMATES;
        }
    }
}